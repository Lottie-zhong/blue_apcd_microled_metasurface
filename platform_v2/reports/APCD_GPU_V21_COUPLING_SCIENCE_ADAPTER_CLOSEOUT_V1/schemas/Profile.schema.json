          "$ref": "#/$defs/Pin"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "profile_id": {
      "const": "coupling_609d_v1",
      "title": "Profile Id",
      "type": "string"
    },
    "truth_toolchain": {
      "additionalProperties": {
        "$ref": "#/$defs/Pin"
      },
      "title": "Truth Toolchain",
      "type": "object"
    }
  },
  "required": [
    "profile_id",
