{
  "$defs": {
    "Pin": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "title": "Pin",
      "type": "object"
    },
    "Profile": {
      "additionalProperties": false,
      "properties": {
        "certification": {
          "$ref": "#/$defs/Pin"
        },
        "postprocess_resolver_certification": {
          "anyOf": [
            {
              "$ref": "#/$defs/Pin"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "profile_id": {
          "const": "coupling_609d_v1",
          "title": "Profile Id",
          "type": "string"
        },
        "truth_toolchain": {
          "additionalProperties": {
            "$ref": "#/$defs/Pin"
          },
          "title": "Truth Toolchain",
          "type": "object"
        }
      },
      "required": [
        "profile_id",
        "truth_toolchain",
        "certification"
      ],
      "title": "Profile",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "automatic_replays": {
      "const": 0,
      "default": 0,
      "title": "Automatic Replays",
      "type": "integer"
    },
    "consumer_sid": {
      "title": "Consumer Sid",
      "type": "string"
    },
    "coupling_root": {
      "title": "Coupling Root",
      "type": "string"
    },
    "executable_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Executable Sha256",
      "type": "string"
    },
    "fdtd_executable": {
      "title": "Fdtd Executable",
      "type": "string"
    },
    "gpu_resource": {
      "const": "GPU license audit",
      "title": "Gpu Resource",
      "type": "string"
    },
    "heartbeat_seconds": {
      "exclusiveMinimum": 0,
      "maximum": 30,
      "title": "Heartbeat Seconds",
      "type": "number"
    },
    "mode": {
      "enum": [
        "PRODUCTION_GPU",
        "PRODUCTION_EQUIVALENT"
      ],
      "title": "Mode",
      "type": "string"
    },
    "native_h5_name": {
      "const": "run_output.h5",
      "title": "Native H5 Name",
      "type": "string"
    },
    "operator_sids": {
      "items": {
        "type": "string"
      },
      "title": "Operator Sids",
      "type": "array"
    },
    "profiles": {
      "items": {
        "$ref": "#/$defs/Profile"
      },
      "title": "Profiles",
      "type": "array"
    },
    "run_policy": {
      "const": "RUN_UNTIL_APPROVED_BATCH_COMPLETE",
      "default": "RUN_UNTIL_APPROVED_BATCH_COMPLETE",
      "title": "Run Policy",
      "type": "string"
    },
    "runtime_root": {
      "title": "Runtime Root",
      "type": "string"
    },
    "schema_version": {
      "const": "APCD_GPU_V21_PLATFORM_V1",
      "title": "Schema Version",
      "type": "string"
    },
    "science_owner_id": {
      "const": "APCD_COUPLING_ML_SCIENCE_OWNER_V1",
      "default": "APCD_COUPLING_ML_SCIENCE_OWNER_V1",
      "title": "Science Owner Id",
      "type": "string"
    },
    "science_owner_sid": {
      "title": "Science Owner Sid",
      "type": "string"
    },
    "science_root": {
      "title": "Science Root",
      "type": "string"
    },
    "slots": {
      "const": 1,
      "default": 1,
      "title": "Slots",
      "type": "integer"
    },
    "source_root": {
      "title": "Source Root",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "mode",
    "runtime_root",
    "science_root",
    "source_root",
    "coupling_root",
    "science_owner_sid",
    "consumer_sid",
    "operator_sids",
    "fdtd_executable",
    "executable_sha256",
    "gpu_resource",
    "native_h5_name",
    "heartbeat_seconds",
    "profiles"
  ],
  "title": "Platform",
  "type": "object"
}